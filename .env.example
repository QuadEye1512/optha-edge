# ---------------------------------------------------------------------------
# OpthaEdge platform configuration. Copy to .env (or .env.production on the Pi)
# and replace every placeholder. Never commit real values.
# ---------------------------------------------------------------------------

# PostgreSQL connection used by Prisma ORM.
DATABASE_URL="postgresql://opthaedge:change-me@127.0.0.1:5432/opthaedge?schema=public"

# Signs the session cookie. 32+ random characters:  openssl rand -base64 48
SESSION_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Browsers drop Secure cookies on plain http://<pi-ip>:3000. Set "false" while the
# app is reached over plain HTTP on the clinic LAN; "true" once HTTPS is in front.
SESSION_COOKIE_SECURE="false"

# Encrypts retinal images at rest (AES-256-GCM). 32+ random characters.
# Losing this key makes every stored image unreadable - back it up securely.
IMAGE_ENCRYPTION_KEY="replace-with-a-random-secret-of-at-least-32-characters"
# Where encrypted images are written (default: ./storage)
STORAGE_DIR="/var/lib/opthaedge/storage"

# Raspberry Pi inference service (edge/server.py). Same machine: localhost.
# Separate machines: the Pi's LAN address, e.g. http://192.168.1.50:8001
INFERENCE_URL="http://127.0.0.1:8001"
# Shared secret; must match INFERENCE_API_KEY in the Pi service environment.
INFERENCE_API_KEY=""

# Claude API for patient education. Without it the platform shows curated guidance.
ANTHROPIC_API_KEY=""
# Optional model override (default claude-opus-5-5)
LLM_MODEL=""

# Base URL used in patient share links (e.g. https://opthaedge.local). Defaults to the request host.
PUBLIC_BASE_URL=""

# Seed (npm run db:seed): organization name and the first administrator account.
ORGANIZATION_NAME="OpthaEdge Screening Clinic"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrator"
# Synthetic demo patient + clinician. Development only.
SEED_DEMO_DATA="false"

# Local development only. Ignored in production even if set to true.
ENABLE_SYNTHETIC_AUTH="false"
SYNTHETIC_AUTH_SUBJECT="synthetic|clinician-reviewer"
