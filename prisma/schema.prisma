generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider     = "postgresql"
  relationMode = "foreignKeys"
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum PatientStatus {
  ACTIVE
  ARCHIVED
  DECEASED
}

enum SexAtBirth {
  FEMALE
  MALE
  INTERSEX
  UNKNOWN
  NOT_RECORDED
}

enum DiabetesType {
  TYPE_1
  TYPE_2
  GESTATIONAL
  OTHER
  UNKNOWN
  NONE_REPORTED
}

enum PregnancyStatus {
  PREGNANT
  NOT_PREGNANT
  UNKNOWN
  NOT_APPLICABLE
  NOT_RECORDED
}

enum SmokingStatus {
  NEVER
  FORMER
  CURRENT
  UNKNOWN
  NOT_RECORDED
}

enum ConsentPurpose {
  CARE_DELIVERY
  IMAGE_PROCESSING
  DATA_RETENTION
  RESEARCH
  COMMUNICATIONS
}

enum ConsentStatus {
  GRANTED
  DECLINED
  REVOKED
  EXPIRED
}

enum Laterality {
  LEFT
  RIGHT
}

enum ExaminationStatus {
  DRAFT
  READY_FOR_SCREENING
  SCREENING_COMPLETE
  PENDING_REVIEW
  REVIEWED
  CANCELLED
}

enum ImageQualityStatus {
  NOT_ASSESSED
  GRADABLE
  UNGRADABLE
  INCONCLUSIVE
}

enum ModelDeploymentStatus {
  BLOCKED_PENDING_VALIDATION
  RESEARCH_ONLY
  APPROVED_FOR_SCREENING
  RETIRED
}

enum PredictionTask {
  DR_BINARY
  DR_SEVERITY
  IMAGE_QUALITY
  LESION_LOCALIZATION
  OTHER_OCULAR_SCREENING
}

enum PredictionStatus {
  COMPLETED
  INCONCLUSIVE
  REJECTED_UNGRADABLE
  FAILED
}

enum ReviewDecision {
  AGREE
  DISAGREE
  INDETERMINATE
  REPEAT_IMAGING
}

enum ReferralUrgency {
  ROUTINE
  SOON
  URGENT
  EMERGENCY
  NOT_APPLICABLE
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum FollowUpStatus {
  SCHEDULED
  DUE
  COMPLETED
  MISSED
  CANCELLED
}

enum MeasurementType {
  HBA1C
  BLOOD_GLUCOSE
  SYSTOLIC_BLOOD_PRESSURE
  DIASTOLIC_BLOOD_PRESSURE
  TOTAL_CHOLESTEROL
  LDL_CHOLESTEROL
  HDL_CHOLESTEROL
  TRIGLYCERIDES
  INTRAOCULAR_PRESSURE
  VISUAL_ACUITY
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ArticleStatus {
  DRAFT
  CLINICAL_REVIEW
  PUBLISHED
  RETIRED
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILED
}

model Organization {
  id                 String                   @id @default(cuid())
  slug               String                   @unique
  name               String
  status             OrganizationStatus       @default(ACTIVE)
  retentionPolicyKey String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  memberships        OrganizationMembership[]
  patients           Patient[]
  consentRecords     ConsentRecord[]
  measurements       ClinicalMeasurement[]
  examinations       Examination[]
  eyeImages          EyeImage[]
  qualityAssessments ImageQualityAssessment[]
  predictions        Prediction[]
  reviews            ClinicianReview[]
  referrals          Referral[]
  carePlans          CarePlan[]
  followUps          FollowUp[]
  appointments       Appointment[]
  auditEvents        AuditEvent[]

  @@map("organizations")
}

model User {
  id                   String                   @id @default(cuid())
  oidcSubject          String                   @unique
  email                String                   @unique
  displayName          String
  status               UserStatus               @default(INVITED)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  memberships          OrganizationMembership[]
  capturedConsents     ConsentRecord[]          @relation("ConsentCapturedBy")
  recordedHistories    MedicalHistory[]         @relation("HistoryRecordedBy")
  recordedMeasurements ClinicalMeasurement[]    @relation("MeasurementRecordedBy")
  uploadedDocuments    ClinicalDocument[]       @relation("DocumentUploadedBy")
  clinicianNotes       ClinicianNote[]
  createdExaminations  Examination[]            @relation("ExaminationCreatedBy")
  reviews              ClinicianReview[]        @relation("ReviewReviewer")
  reviewAmendments     ReviewAmendment[]
  diagnoses            ClinicianDiagnosis[]
  treatments           Treatment[]
  createdCarePlans     CarePlan[]               @relation("CarePlanCreatedBy")
  auditEvents          AuditEvent[]             @relation("AuditActor")

  @@map("users")
}

model Role {
  id          String                   @id @default(cuid())
  code        String                   @unique
  name        String
  description String?
  memberships OrganizationMembership[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model OrganizationMembership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  activeFrom     DateTime     @default(now())
  activeUntil    DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("organization_memberships")
}

model Patient {
  id               String                @id @default(cuid())
  organizationId   String
  patientNumber    String
  status           PatientStatus         @default(ACTIVE)
  archivedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  demographics     PatientDemographics?
  identifiers      PatientIdentifier[]
  contacts         PatientContact[]
  consents         ConsentRecord[]
  medicalHistories MedicalHistory[]
  riskFactors      RiskFactor[]
  measurements     ClinicalMeasurement[]
  medications      Medication[]
  allergies        Allergy[]
  ocularHistories  OcularHistory[]
  documents        ClinicalDocument[]
  notes            ClinicianNote[]
  examinations     Examination[]
  referrals        Referral[]
  treatments       Treatment[]
  carePlans        CarePlan[]
  followUps        FollowUp[]
  appointments     Appointment[]

  @@unique([organizationId, patientNumber])
  @@index([organizationId, status])
  @@map("patients")
}

model PatientDemographics {
  id                String     @id @default(cuid())
  patientId         String     @unique
  givenName         String
  familyName        String
  dateOfBirth       DateTime?  @db.Date
  sexAtBirth        SexAtBirth @default(NOT_RECORDED)
  preferredName     String?
  preferredLanguage String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  patient           Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([familyName, givenName])
  @@map("patient_demographics")
}

model PatientIdentifier {
  id         String    @id @default(cuid())
  patientId  String
  type       String
  issuer     String
  value      String
  validFrom  DateTime  @default(now())
  validUntil DateTime?
  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@unique([issuer, type, value])
  @@index([patientId])
  @@map("patient_identifiers")
}

model PatientContact {
  id         String  @id @default(cuid())
  patientId  String
  type       String
  value      String
  isPrimary  Boolean @default(false)
  isVerified Boolean @default(false)
  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@map("patient_contacts")
}

model ConsentRecord {
  id                 String         @id @default(cuid())
  organizationId     String
  patientId          String
  purpose            ConsentPurpose
  status             ConsentStatus
  policyVersion      String
  capturedAt         DateTime       @default(now())
  revokedAt          DateTime?
  expiresAt          DateTime?
  evidenceStorageKey String?
  capturedByUserId   String?
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient            Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  capturedBy         User?          @relation("ConsentCapturedBy", fields: [capturedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, patientId, purpose, status])
  @@index([capturedByUserId])
  @@map("consent_records")
}

model MedicalHistory {
  id                  String          @id @default(cuid())
  patientId           String
  diabetesType        DiabetesType    @default(UNKNOWN)
  diabetesDiagnosedAt DateTime?       @db.Date
  pregnancyStatus     PregnancyStatus @default(NOT_RECORDED)
  smokingStatus       SmokingStatus   @default(NOT_RECORDED)
  visualSymptoms      String?
  notes               String?
  effectiveAt         DateTime        @default(now())
  recordedByUserId    String?
  recordedAt          DateTime        @default(now())
  patient             Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  recordedBy          User?           @relation("HistoryRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([patientId, effectiveAt])
  @@index([recordedByUserId])
  @@map("medical_histories")
}

model RiskFactor {
  id         String    @id @default(cuid())
  patientId  String
  code       String
  value      String?
  observedAt DateTime  @default(now())
  resolvedAt DateTime?
  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, code, observedAt])
  @@map("risk_factors")
}

model ClinicalMeasurement {
  id               String          @id @default(cuid())
  organizationId   String
  patientId        String
  type             MeasurementType
  value            Decimal         @db.Decimal(12, 4)
  unit             String
  observedAt       DateTime
  source           String?
  recordedByUserId String?
  createdAt        DateTime        @default(now())
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient          Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  recordedBy       User?           @relation("MeasurementRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, patientId, type, observedAt])
  @@index([recordedByUserId])
  @@map("clinical_measurements")
}

model Medication {
  id           String    @id @default(cuid())
  patientId    String
  name         String
  instructions String?
  startedAt    DateTime? @db.Date
  endedAt      DateTime? @db.Date
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@map("medications")
}

model Allergy {
  id         String   @id @default(cuid())
  patientId  String
  substance  String
  reaction   String?
  severity   String?
  recordedAt DateTime @default(now())
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@map("allergies")
}

model OcularHistory {
  id                 String      @id @default(cuid())
  patientId          String
  eye                Laterality?
  condition          String
  surgeryOrTreatment String?
  occurredAt         DateTime?   @db.Date
  notes              String?
  patient            Patient     @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, eye])
  @@map("ocular_histories")
}

model ClinicalDocument {
  id               String   @id @default(cuid())
  patientId        String
  title            String
  documentType     String
  storageKey       String   @unique
  sha256           String
  mimeType         String
  uploadedByUserId String?
  uploadedAt       DateTime @default(now())
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  uploadedBy       User?    @relation("DocumentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([patientId, uploadedAt])
  @@index([uploadedByUserId])
  @@map("clinical_documents")
}

model ClinicianNote {
  id        String    @id @default(cuid())
  patientId String
  authorId  String
  note      String
  createdAt DateTime  @default(now())
  amendedAt DateTime?
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([patientId, createdAt])
  @@index([authorId])
  @@map("clinician_notes")
}

model Examination {
  id              String               @id @default(cuid())
  organizationId  String
  patientId       String
  eye             Laterality
  status          ExaminationStatus    @default(DRAFT)
  examinedAt      DateTime             @default(now())
  imageSource     String?
  captureDevice   String?
  createdByUserId String
  createdAt       DateTime             @default(now())
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient         Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdBy       User                 @relation("ExaminationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  images          EyeImage[]
  predictions     Prediction[]
  reviews         ClinicianReview[]
  diagnoses       ClinicianDiagnosis[]
  referrals       Referral[]
  treatments      Treatment[]
  carePlans       CarePlan[]

  @@index([organizationId, patientId, eye, examinedAt])
  @@index([createdByUserId])
  @@map("examinations")
}

model EyeImage {
  id                 String                   @id @default(cuid())
  organizationId     String
  examinationId      String
  eye                Laterality
  storageKey         String
  sha256             String
  mimeType           String
  width              Int
  height             Int
  capturedAt         DateTime?
  createdAt          DateTime                 @default(now())
  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  examination        Examination              @relation(fields: [examinationId], references: [id], onDelete: Restrict)
  qualityAssessments ImageQualityAssessment[]
  predictions        Prediction[]

  @@unique([organizationId, storageKey])
  @@index([examinationId, eye])
  @@index([organizationId, sha256])
  @@map("eye_images")
}

model ImageQualityAssessment {
  id             String             @id @default(cuid())
  organizationId String
  eyeImageId     String
  modelVersionId String?
  status         ImageQualityStatus
  reasonCodes    String[]
  score          Decimal?           @db.Decimal(8, 6)
  assessedAt     DateTime           @default(now())
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  eyeImage       EyeImage           @relation(fields: [eyeImageId], references: [id], onDelete: Restrict)
  modelVersion   ModelVersion?      @relation(fields: [modelVersionId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, assessedAt])
  @@index([eyeImageId])
  @@index([modelVersionId])
  @@map("image_quality_assessments")
}

model ModelVersion {
  id                         String                   @id @default(cuid())
  modelKey                   String
  version                    String
  artifactSha256             String                   @unique
  task                       PredictionTask
  artifactStorageKey         String?
  inputSpecification         Json
  outputLabels               Json
  labelOrderVerified         Boolean                  @default(false)
  preprocessingSpecification Json
  preprocessingVerified      Boolean                  @default(false)
  decisionThresholds         Json?
  calibrationMethod          String?
  validationDataset          String?
  validationMetrics          Json?
  intendedUse                String
  knownLimitations           Json
  deploymentStatus           ModelDeploymentStatus    @default(BLOCKED_PENDING_VALIDATION)
  approvedAt                 DateTime?
  createdAt                  DateTime                 @default(now())
  qualityAssessments         ImageQualityAssessment[]
  predictions                Prediction[]

  @@unique([modelKey, version])
  @@index([task, deploymentStatus])
  @@map("model_versions")
}

model Prediction {
  id                   String                  @id @default(cuid())
  organizationId       String
  examinationId        String
  eyeImageId           String
  modelVersionId       String
  task                 PredictionTask
  status               PredictionStatus
  outcome              String?
  drGrade              String?
  rawOutput            Json?
  confidence           Decimal?                @db.Decimal(8, 6)
  uncertainty          Decimal?                @db.Decimal(8, 6)
  inferenceTimeMs      Decimal?                @db.Decimal(12, 3)
  createdAt            DateTime                @default(now())
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  examination          Examination             @relation(fields: [examinationId], references: [id], onDelete: Restrict)
  eyeImage             EyeImage                @relation(fields: [eyeImageId], references: [id], onDelete: Restrict)
  modelVersion         ModelVersion            @relation(fields: [modelVersionId], references: [id], onDelete: Restrict)
  probabilities        PredictionProbability[]
  lesionFindings       LesionFinding[]
  explainabilityAssets ExplainabilityAsset[]
  reviews              ClinicianReview[]

  @@index([organizationId, examinationId, createdAt])
  @@index([eyeImageId])
  @@index([modelVersionId])
  @@map("predictions")
}

model PredictionProbability {
  id           String     @id @default(cuid())
  predictionId String
  label        String
  labelIndex   Int
  rawScore     Decimal?   @db.Decimal(12, 8)
  probability  Decimal?   @db.Decimal(12, 8)
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Restrict)

  @@unique([predictionId, labelIndex])
  @@map("prediction_probabilities")
}

model LesionFinding {
  id           String     @id @default(cuid())
  predictionId String
  lesionType   String
  score        Decimal?   @db.Decimal(8, 6)
  geometry     Json?
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Restrict)

  @@index([predictionId])
  @@map("lesion_findings")
}

model ExplainabilityAsset {
  id            String     @id @default(cuid())
  predictionId  String
  method        String
  methodVersion String?
  storageKey    String     @unique
  limitations   String
  createdAt     DateTime   @default(now())
  prediction    Prediction @relation(fields: [predictionId], references: [id], onDelete: Restrict)

  @@index([predictionId])
  @@map("explainability_assets")
}

/// Deferred Review Queue data model. Retained to avoid destructive schema changes.
model ClinicianReview {
  id                  String               @id @default(cuid())
  organizationId      String
  examinationId       String
  predictionId        String?
  reviewerId          String
  decision            ReviewDecision
  assessment          String
  referralUrgency     ReferralUrgency      @default(NOT_APPLICABLE)
  referralReason      String?
  repeatImagingReason String?
  signedAt            DateTime?
  lockedAt            DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  examination         Examination          @relation(fields: [examinationId], references: [id], onDelete: Restrict)
  prediction          Prediction?          @relation(fields: [predictionId], references: [id], onDelete: Restrict)
  reviewer            User                 @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  amendments          ReviewAmendment[]
  diagnoses           ClinicianDiagnosis[]
  referrals           Referral[]

  @@index([organizationId, signedAt])
  @@index([examinationId])
  @@index([predictionId])
  @@index([reviewerId])
  @@map("clinician_reviews")
}

/// Deferred Review Queue data model. Retained to avoid destructive schema changes.
model ReviewAmendment {
  id        String          @id @default(cuid())
  reviewId  String
  authorId  String
  reason    String
  amendment String
  createdAt DateTime        @default(now())
  review    ClinicianReview @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  author    User            @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([reviewId, createdAt])
  @@index([authorId])
  @@map("review_amendments")
}

/// Deferred Review Queue data model. Retained to avoid destructive schema changes.
model ClinicianDiagnosis {
  id            String           @id @default(cuid())
  examinationId String
  reviewId      String?
  clinicianId   String
  codeSystem    String?
  code          String?
  display       String
  recordedAt    DateTime         @default(now())
  examination   Examination      @relation(fields: [examinationId], references: [id], onDelete: Restrict)
  review        ClinicianReview? @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  clinician     User             @relation(fields: [clinicianId], references: [id], onDelete: Restrict)

  @@index([examinationId])
  @@index([reviewId])
  @@index([clinicianId])
  @@map("clinician_diagnoses")
}

/// Deferred care-journey data model. Retained to avoid destructive schema changes.
model Referral {
  id             String           @id @default(cuid())
  organizationId String
  patientId      String
  examinationId  String
  reviewId       String?
  urgency        ReferralUrgency
  status         WorkflowStatus   @default(ACTIVE)
  destination    String?
  reason         String
  referredAt     DateTime         @default(now())
  completedAt    DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient        Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  examination    Examination      @relation(fields: [examinationId], references: [id], onDelete: Restrict)
  review         ClinicianReview? @relation(fields: [reviewId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, urgency])
  @@index([patientId])
  @@index([examinationId])
  @@index([reviewId])
  @@map("referrals")
}

/// Deferred care-journey data model. Retained to avoid destructive schema changes.
model Treatment {
  id            String       @id @default(cuid())
  patientId     String
  examinationId String?
  recordedById  String
  treatmentType String
  description   String
  performedAt   DateTime?
  recordedAt    DateTime     @default(now())
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  examination   Examination? @relation(fields: [examinationId], references: [id], onDelete: Restrict)
  recordedBy    User         @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([patientId, performedAt])
  @@index([examinationId])
  @@index([recordedById])
  @@map("treatments")
}

/// Deferred care-journey data model. Retained to avoid destructive schema changes.
model CarePlan {
  id              String         @id @default(cuid())
  organizationId  String
  patientId       String
  examinationId   String?
  createdByUserId String
  title           String
  plan            String
  status          WorkflowStatus @default(DRAFT)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient         Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  examination     Examination?   @relation(fields: [examinationId], references: [id], onDelete: Restrict)
  createdBy       User           @relation("CarePlanCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  followUps       FollowUp[]

  @@index([organizationId, status])
  @@index([patientId])
  @@index([examinationId])
  @@index([createdByUserId])
  @@map("care_plans")
}

/// Deferred Follow-ups data model. Retained to avoid destructive schema changes.
model FollowUp {
  id             String         @id @default(cuid())
  organizationId String
  patientId      String
  carePlanId     String?
  status         FollowUpStatus @default(SCHEDULED)
  dueAt          DateTime
  completedAt    DateTime?
  notes          String?
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient        Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  carePlan       CarePlan?      @relation(fields: [carePlanId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, dueAt])
  @@index([patientId])
  @@index([carePlanId])
  @@map("follow_ups")
}

/// Deferred Follow-ups data model. Retained to avoid destructive schema changes.
model Appointment {
  id              String            @id @default(cuid())
  organizationId  String
  patientId       String
  scheduledAt     DateTime
  status          AppointmentStatus @default(SCHEDULED)
  appointmentType String
  location        String?
  notes           String?
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, scheduledAt])
  @@index([patientId])
  @@map("appointments")
}

model EducationalArticle {
  id             String           @id @default(cuid())
  slug           String           @unique
  title          String
  conditionGroup String
  status         ArticleStatus    @default(DRAFT)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  versions       ArticleVersion[]

  @@index([conditionGroup, status])
  @@map("educational_articles")
}

model ArticleVersion {
  id                String                 @id @default(cuid())
  articleId         String
  version           Int
  content           Json
  medicalReviewDate DateTime?              @db.Date
  reviewedByDisplay String?
  createdAt         DateTime               @default(now())
  article           EducationalArticle     @relation(fields: [articleId], references: [id], onDelete: Restrict)
  sources           ArticleSource[]
  medicalReviews    MedicalContentReview[]

  @@unique([articleId, version])
  @@map("article_versions")
}

model MedicalSource {
  id              String          @id @default(cuid())
  title           String
  organization    String
  url             String          @unique
  publicationYear Int?
  accessedAt      DateTime        @db.Date
  sourceLinks     ArticleSource[]

  @@map("medical_sources")
}

model ArticleSource {
  articleVersionId String
  medicalSourceId  String
  sectionKey       String
  articleVersion   ArticleVersion @relation(fields: [articleVersionId], references: [id], onDelete: Restrict)
  medicalSource    MedicalSource  @relation(fields: [medicalSourceId], references: [id], onDelete: Restrict)

  @@id([articleVersionId, medicalSourceId, sectionKey])
  @@index([medicalSourceId])
  @@map("article_sources")
}

model MedicalContentReview {
  id               String         @id @default(cuid())
  articleVersionId String
  reviewerDisplay  String
  decision         String
  notes            String?
  reviewedAt       DateTime       @default(now())
  articleVersion   ArticleVersion @relation(fields: [articleVersionId], references: [id], onDelete: Restrict)

  @@index([articleVersionId, reviewedAt])
  @@map("medical_content_reviews")
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  resourceType   String
  resourceId     String
  outcome        AuditOutcome
  requestId      String?
  metadata       Json?
  occurredAt     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, resourceType, resourceId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("audit_events")
}
